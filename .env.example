NODE_ENV=production
PORT=4000
TRUST_PROXY=false
CORS_ORIGINS=https://your-domain.example

# News provider
NEWSAPI_KEY=your_newsapi_key_here

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/brief
DATABASE_SSL=true
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000
REQUIRE_DATABASE=true

# Weather
OPENWEATHER_KEY=your_openweather_key_here
DEFAULT_CITY=Jaipur

# Analytics - set the GA4 Measurement ID in production
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional single-operator admin endpoint for manual catalog updates.
# Use a long random value; replace with real auth in a multi-operator deployment.
ADMIN_TOKEN=replace_with_long_random_secret
